{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.ts",
	"name": "maintenance-hack",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// 자기 자신 참조 (워커 이름과 같아야 함)
			"binding": "WORKER_SELF_REFERENCE",
			"service": "maintenance-hack"
		}
	],
	// 부품 호환 확인(AI) 하루 조회 횟수 제한용 (lib/verify-limit.ts). 무료 KV
	"kv_namespaces": [{ "binding": "VERIFY_LIMIT", "id": "19092b499f78410c8c4e5b94fdffb960" }],
	// 하루 횟수 세기(견적서·부품 확인·쿠팡 검색)를 한 번에 하나씩 처리하는 Durable Object (lib/limit-counter.ts, worker.ts에서 내보냄).
	// KV는 동시에 몰아 보내면 한도를 넘을 수 있어서. 무료 요금제는 SQLite 방식만 됨
	"durable_objects": { "bindings": [{ "name": "LIMITS", "class_name": "LimitCounter" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["LimitCounter"] }],
	// 무료 방문 분석은 Cloudflare 대시보드 > Workers > maintenance-hack > Metrics 에서 확인
	"observability": { "enabled": true },
	// 교체 시기 알림: 매일 00:00 UTC = 09:00 한국 시간 (worker.ts scheduled). 비밀 키는 wrangler secret put VAPID_PRIVATE_KEY
	"triggers": { "crons": ["0 0 * * *"] },
	// 운영 도메인 (Cloudflare Registrar에서 구매, 2026-11-24). www와 workers.dev는 middleware.ts에서 jungbihack.com으로 넘김
	// routes가 있으면 workers.dev가 기본으로 꺼지므로 명시적으로 켠다 (예전 주소 → 301, 미리보기 주소 유지)
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{ "pattern": "jungbihack.com", "custom_domain": true },
		{ "pattern": "www.jungbihack.com", "custom_domain": true }
	]
}
